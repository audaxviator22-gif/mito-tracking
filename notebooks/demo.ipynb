# Environment
import sys
from pathlib import Path

import cv2
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

import mito_tracking
from mito_tracking.detector import MitochondriaDetector
from mito_tracking.tracker import MLTracker, TrackingAnnotationGenerator
from mito_tracking.features import TrackingFeatureExtractor
from mito_tracking.training import TrackingModelTrainer
from mito_tracking.visualization import TrackVisualizer
from mito_tracking.io import load_config

# Ensure figures directory exists for saved outputs
Path("figures").mkdir(exist_ok=True)
Path("results").mkdir(exist_ok=True)

print(f"mito-tracking v{mito_tracking.__version__}")
print(f"Python       {sys.version.split()[0]}")
print(f"OpenCV       {cv2.__version__}")
print(f"NumPy        {np.__version__}")
print(f"pandas       {pd.__version__}")

# Configuration & example data
cfg = load_config("configs/default.yaml")

example_dir = Path("examples")
video_path  = example_dir / "example_video.mp4"
model_path  = Path("models/tracking_model.pkl")

if not video_path.exists():
    raise FileNotFoundError(
        f"Example video not found at {video_path}. "
        "The repository provides a small number of examples/. "
        "If it is missing, run: bash scripts/download_example.sh"
    )

print(f"Config : ppm={cfg.detection.pixels_per_micrometer}, "
      f"fps={cfg.tracking.fps}, "
      f"assoc_thresh={cfg.tracking.association_threshold}")
print(f"Video  : {video_path}  ({video_path.stat().st_size / 1e6:.1f} MB)")
print(f"Model  : {model_path}  (exists: {model_path.exists()})")

#Detection and visualization
# Read first frame
cap = cv2.VideoCapture(str(video_path))
ret, frame = cap.read()
cap.release()
assert ret, "Could not read the first frame of the example video."

# Detect
detector = MitochondriaDetector(
    pixels_per_micrometer=cfg.detection.pixels_per_micrometer
)
detections = detector.detect(frame, confidence_threshold=0.6)
print(f"Detected {len(detections)} mitochondria.")

# Annotate
vis = frame.copy()
for d in detections:
    x, y, w, h = d["bbox"]
    cv2.rectangle(vis, (x, y), (x + w, y + h), (0, 255, 0), 1)

fig, axes = plt.subplots(1, 2, figsize=(10, 5))
axes[0].imshow(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
axes[0].set_title("Raw frame")
axes[1].imshow(cv2.cvtColor(vis, cv2.COLOR_BGR2RGB))
axes[1].set_title(f"{len(detections)} detections")
for ax in axes:
    ax.axis("off")
plt.tight_layout()
plt.savefig("figures/demo_detection.png", dpi=150, bbox_inches="tight")
plt.show()

#Feature extraction demo
# Feature extraction between two detections
fx = TrackingFeatureExtractor(ppm=cfg.detection.pixels_per_micrometer)

if len(detections) >= 2:
    f = fx.compute_features(detections[0], detections[1])
    print("Example feature vector between detections[0] and detections[1]:")
    print(f"  position_distance    : {f.position_distance:.4f}")
    print(f"  area_ratio           : {f.area_ratio:.4f}")
    print(f"  intensity_similarity : {f.intensity_similarity:.4f}")
    print(f"  shape_similarity     : {f.shape_similarity:.4f}")
    print(f"  iou                  : {f.iou:.4f}")
else:
    print("Not enough detections in the first frame to compute a feature vector.")

# Example video tracking
if not model_path.exists():
    print(f"  No trained model at {model_path}.")
    print("   Run `python scripts/train.py --annotations data/raw` first,")
    print("   or continue to Section 5 to train from the bundled example.")
    results = None
else:
    tracker = MLTracker(
        tracking_model_path=str(model_path),
        pixels_per_micrometer=cfg.detection.pixels_per_micrometer,
        fps=cfg.tracking.fps,
        association_threshold=cfg.tracking.association_threshold,
    )
    results = tracker.track_video(
        str(video_path),
        output_dir="results/",
        save_visualization=False,
    )
    print(f"\nTotal tracks: {results['total_tracks']}")
    print(f"  avg length : {results['statistics']['avg_track_length']:.1f} frames")
    print(f"  avg speed  : {results['statistics']['avg_speed_um_s']:.3f} µm/s")
    print(f"  avg area   : {results['statistics']['avg_area_um2']:.3f} µm²")

# Visualizing tracks
if results and results.get("tracks"):
    viz = TrackVisualizer(
        results["tracks"],
        pixels_per_um=cfg.detection.pixels_per_micrometer,
        fps=cfg.tracking.fps,
    )
    viz.plot_track_trajectories(
        output_file="figures/demo_trajectories.png"
    )
    viz.plot_velocity_distribution(
        output_file="figures/demo_velocity.png"
    )
else:
    print("Skipping visualization: no tracks available.")

# Training on bundled example annotations
example_annotations = Path("data/example/annotations")

if not example_annotations.exists():
    print(f"  Example annotations not found at {example_annotations}.")
    print("   See data/README.md for download instructions.")
else:
    trainer = TrackingModelTrainer()
    ok = trainer.train(str(example_annotations))
    if ok:
        trainer.save_model("results/demo_tracking_model.pkl")
        print("\n✓ Model trained and saved to results/demo_tracking_model.pkl")

# Full paper reproduction (off by default)
FULL_RUN = False   # ← flip to True after downloading Zenodo data

if FULL_RUN:
    from mito_tracking.batch import BatchProcessor

    test_dir = Path("data/raw/test")
    if not test_dir.exists():
        raise FileNotFoundError(
            "Test data not found. Download from Zenodo; see data/README.md."
        )

    proc = BatchProcessor(
        ppm=cfg.detection.pixels_per_micrometer,
        fps=cfg.tracking.fps,
    )
    proc.process_folder(
        input_folder=str(test_dir),
        output_folder="results/full_run/",
        save_visualizations=False,
    )

    summary = pd.read_csv("results/full_run/batch_summary.csv")
    print(f"Processed {len(summary)} videos.")
    print(summary.describe())
    # Figure 3 of the paper is re-generated by scripts/make_figures.py
else:
    print("Skipped full run. Set FULL_RUN=True after downloading data.")

# Inspect what the pipeline produced
training_csv = Path("results/training_data_all.csv")

if training_csv.exists():
    df = pd.read_csv(training_csv)
    print(f"Exported {len(df)} detections")
    print(f"Columns: {list(df.columns)}")
    display(df.head())
else:
    print(f"No training data yet at {training_csv}.")
    print("It is produced by the BatchProcessor (Section 6).")
